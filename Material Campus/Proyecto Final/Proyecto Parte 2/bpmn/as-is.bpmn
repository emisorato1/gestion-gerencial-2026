<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="generar_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Atender_pedido_de_distribuidor__AS-IS_">
    <bpmn:participant id="Participant_distribuidor" name="Distribuidor" />
    <bpmn:participant id="Participant_dulxelitos" name="Dulxelitos" processRef="Process_dulxelitos" />
    <bpmn:participant id="Participant_transporte" name="Transporte tercerizado" />
    <bpmn:messageFlow id="MessageFlow_distribuidor_ini_pedido" name="Pedido por WhatsApp o teléfono" sourceRef="Participant_distribuidor" targetRef="Event_ini_pedido" />
    <bpmn:messageFlow id="MessageFlow_avisar_distribuidor" name="Aviso de pedido incompleto" sourceRef="Activity_avisar" targetRef="Participant_distribuidor" />
    <bpmn:messageFlow id="MessageFlow_tercerizado_transporte" name="Pedido a entregar" sourceRef="Activity_tercerizado" targetRef="Participant_transporte" />
  </bpmn:collaboration>
  <bpmn:process id="Process_dulxelitos" isExecutable="false">
    <bpmn:laneSet id="LaneSet_dulxelitos">
      <bpmn:lane id="Lane_oficina" name="Oficina">
        <bpmn:flowNodeRef>Event_ini_pedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_anotar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_and_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_preguntar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_and_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_lista</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_xor_faltante</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_avisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_union</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_facturar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_deposito" name="Depósito">
        <bpmn:flowNodeRef>Activity_mirar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_preparar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_xor_falta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_xor_despacho</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_flota</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_tercerizado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_fin_pedido</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_produccion" name="Producción">
        <bpmn:flowNodeRef>Activity_producir_decidido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_registrar_produccion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_fin_semana</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_esperar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_horas_extras</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_direccion" name="Dirección">
        <bpmn:flowNodeRef>Event_ini_semana</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_decidir</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_ini_pedido" name="Pedido recibido">
      <bpmn:outgoing>Flow_ini_pedido_anotar</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_ini_pedido" />
    </bpmn:startEvent>
    <bpmn:task id="Activity_anotar" name="Anotar pedido en papel o planilla">
      <bpmn:incoming>Flow_ini_pedido_anotar</bpmn:incoming>
      <bpmn:outgoing>Flow_anotar_and_ini</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_anotar_papel">
        <bpmn:targetRef>DataObjectReference_papel</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObject id="DataObject_papel" />
    <bpmn:dataObjectReference id="DataObjectReference_papel" name="Papel o planilla" dataObjectRef="DataObject_papel" />
    <bpmn:parallelGateway id="Gateway_and_ini" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_anotar_and_ini</bpmn:incoming>
      <bpmn:outgoing>Flow_and_ini_preguntar</bpmn:outgoing>
      <bpmn:outgoing>Flow_and_ini_mirar</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Activity_preguntar" name="Preguntar disponibilidad a producción">
      <bpmn:incoming>Flow_and_ini_preguntar</bpmn:incoming>
      <bpmn:outgoing>Flow_preguntar_and_fin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_and_fin" gatewayDirection="Converging">
      <bpmn:incoming>Flow_preguntar_and_fin</bpmn:incoming>
      <bpmn:incoming>Flow_mirar_and_fin</bpmn:incoming>
      <bpmn:outgoing>Flow_and_fin_lista</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Activity_lista" name="Pasar pedido a la lista">
      <bpmn:incoming>Flow_and_fin_lista</bpmn:incoming>
      <bpmn:outgoing>Flow_lista_preparar</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_lista_lista_datos">
        <bpmn:targetRef>DataObjectReference_lista_datos</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObject id="DataObject_lista_datos" />
    <bpmn:dataObjectReference id="DataObjectReference_lista_datos" name="Lista de pedidos" dataObjectRef="DataObject_lista_datos" />
    <bpmn:exclusiveGateway id="Gateway_xor_faltante" name="¿Qué se hace con el faltante?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_xor_falta_xor_faltante</bpmn:incoming>
      <bpmn:outgoing>Flow_xor_faltante_avisar</bpmn:outgoing>
      <bpmn:outgoing>Flow_xor_faltante_esperar</bpmn:outgoing>
      <bpmn:outgoing>Flow_xor_faltante_horas_extras</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_avisar" name="Avisar al distribuidor del faltante">
      <bpmn:incoming>Flow_xor_faltante_avisar</bpmn:incoming>
      <bpmn:outgoing>Flow_avisar_union</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_union" gatewayDirection="Converging">
      <bpmn:incoming>Flow_xor_falta_union</bpmn:incoming>
      <bpmn:incoming>Flow_avisar_union</bpmn:incoming>
      <bpmn:incoming>Flow_esperar_union</bpmn:incoming>
      <bpmn:incoming>Flow_horas_extras_union</bpmn:incoming>
      <bpmn:outgoing>Flow_union_facturar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_facturar" name="Facturar en Discovery">
      <bpmn:incoming>Flow_union_facturar</bpmn:incoming>
      <bpmn:outgoing>Flow_facturar_xor_despacho</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Activity_mirar" name="Mirar el stock a ojo">
      <bpmn:incoming>Flow_and_ini_mirar</bpmn:incoming>
      <bpmn:outgoing>Flow_mirar_and_fin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_preparar" name="Preparar pedido">
      <bpmn:incoming>Flow_lista_preparar</bpmn:incoming>
      <bpmn:outgoing>Flow_preparar_xor_falta</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_xor_falta" name="¿Falta producto?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_preparar_xor_falta</bpmn:incoming>
      <bpmn:outgoing>Flow_xor_falta_union</bpmn:outgoing>
      <bpmn:outgoing>Flow_xor_falta_xor_faltante</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_xor_despacho" name="¿Con qué se despacha?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_facturar_xor_despacho</bpmn:incoming>
      <bpmn:outgoing>Flow_xor_despacho_flota</bpmn:outgoing>
      <bpmn:outgoing>Flow_xor_despacho_tercerizado</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_flota" name="Despachar con flota propia">
      <bpmn:incoming>Flow_xor_despacho_flota</bpmn:incoming>
      <bpmn:outgoing>Flow_flota_fin_pedido</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_tercerizado" name="Entregar a transporte tercerizado">
      <bpmn:incoming>Flow_xor_despacho_tercerizado</bpmn:incoming>
      <bpmn:outgoing>Flow_tercerizado_fin_pedido</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_fin_pedido" name="Pedido despachado">
      <bpmn:incoming>Flow_flota_fin_pedido</bpmn:incoming>
      <bpmn:incoming>Flow_tercerizado_fin_pedido</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="DataObject_datos_produccion" />
    <bpmn:dataObjectReference id="DataObjectReference_datos_produccion" name="Registro semanal de producción" dataObjectRef="DataObject_datos_produccion" />
    <bpmn:task id="Activity_producir_decidido" name="Producir lo decidido">
      <bpmn:incoming>Flow_decidir_producir_decidido</bpmn:incoming>
      <bpmn:outgoing>Flow_producir_decidido_registrar_produccion</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_registrar_produccion" name="Registrar producción de la semana">
      <bpmn:incoming>Flow_producir_decidido_registrar_produccion</bpmn:incoming>
      <bpmn:outgoing>Flow_registrar_produccion_fin_semana</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_registrar_produccion_datos_produccion">
        <bpmn:targetRef>DataObjectReference_datos_produccion</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="Event_fin_semana" name="Producción registrada">
      <bpmn:incoming>Flow_registrar_produccion_fin_semana</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Activity_esperar" name="Producir lo que falta">
      <bpmn:incoming>Flow_xor_faltante_esperar</bpmn:incoming>
      <bpmn:outgoing>Flow_esperar_union</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_horas_extras" name="Producir con horas extras">
      <bpmn:incoming>Flow_xor_faltante_horas_extras</bpmn:incoming>
      <bpmn:outgoing>Flow_horas_extras_union</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="Event_ini_semana" name="Semana iniciada">
      <bpmn:outgoing>Flow_ini_semana_decidir</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_ini_semana" />
    </bpmn:startEvent>
    <bpmn:task id="Activity_decidir" name="Decidir producción">
      <bpmn:incoming>Flow_ini_semana_decidir</bpmn:incoming>
      <bpmn:outgoing>Flow_decidir_producir_decidido</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_ini_pedido_anotar" sourceRef="Event_ini_pedido" targetRef="Activity_anotar" />
    <bpmn:sequenceFlow id="Flow_anotar_and_ini" sourceRef="Activity_anotar" targetRef="Gateway_and_ini" />
    <bpmn:sequenceFlow id="Flow_and_ini_preguntar" sourceRef="Gateway_and_ini" targetRef="Activity_preguntar" />
    <bpmn:sequenceFlow id="Flow_and_ini_mirar" sourceRef="Gateway_and_ini" targetRef="Activity_mirar" />
    <bpmn:sequenceFlow id="Flow_preguntar_and_fin" sourceRef="Activity_preguntar" targetRef="Gateway_and_fin" />
    <bpmn:sequenceFlow id="Flow_mirar_and_fin" sourceRef="Activity_mirar" targetRef="Gateway_and_fin" />
    <bpmn:sequenceFlow id="Flow_and_fin_lista" sourceRef="Gateway_and_fin" targetRef="Activity_lista" />
    <bpmn:sequenceFlow id="Flow_lista_preparar" sourceRef="Activity_lista" targetRef="Activity_preparar" />
    <bpmn:sequenceFlow id="Flow_preparar_xor_falta" sourceRef="Activity_preparar" targetRef="Gateway_xor_falta" />
    <bpmn:sequenceFlow id="Flow_xor_falta_union" name="No" sourceRef="Gateway_xor_falta" targetRef="Gateway_union" />
    <bpmn:sequenceFlow id="Flow_xor_falta_xor_faltante" name="Sí" sourceRef="Gateway_xor_falta" targetRef="Gateway_xor_faltante" />
    <bpmn:sequenceFlow id="Flow_xor_faltante_avisar" name="Se manda incompleto" sourceRef="Gateway_xor_faltante" targetRef="Activity_avisar" />
    <bpmn:sequenceFlow id="Flow_xor_faltante_esperar" name="Se espera producción" sourceRef="Gateway_xor_faltante" targetRef="Activity_esperar" />
    <bpmn:sequenceFlow id="Flow_xor_faltante_horas_extras" name="Horas extras, si hace falta" sourceRef="Gateway_xor_faltante" targetRef="Activity_horas_extras" />
    <bpmn:sequenceFlow id="Flow_avisar_union" sourceRef="Activity_avisar" targetRef="Gateway_union" />
    <bpmn:sequenceFlow id="Flow_esperar_union" sourceRef="Activity_esperar" targetRef="Gateway_union" />
    <bpmn:sequenceFlow id="Flow_horas_extras_union" sourceRef="Activity_horas_extras" targetRef="Gateway_union" />
    <bpmn:sequenceFlow id="Flow_union_facturar" sourceRef="Gateway_union" targetRef="Activity_facturar" />
    <bpmn:sequenceFlow id="Flow_facturar_xor_despacho" sourceRef="Activity_facturar" targetRef="Gateway_xor_despacho" />
    <bpmn:sequenceFlow id="Flow_xor_despacho_flota" name="Flota propia" sourceRef="Gateway_xor_despacho" targetRef="Activity_flota" />
    <bpmn:sequenceFlow id="Flow_xor_despacho_tercerizado" name="Transporte tercerizado" sourceRef="Gateway_xor_despacho" targetRef="Activity_tercerizado" />
    <bpmn:sequenceFlow id="Flow_flota_fin_pedido" sourceRef="Activity_flota" targetRef="Event_fin_pedido" />
    <bpmn:sequenceFlow id="Flow_tercerizado_fin_pedido" sourceRef="Activity_tercerizado" targetRef="Event_fin_pedido" />
    <bpmn:sequenceFlow id="Flow_ini_semana_decidir" sourceRef="Event_ini_semana" targetRef="Activity_decidir" />
    <bpmn:sequenceFlow id="Flow_decidir_producir_decidido" sourceRef="Activity_decidir" targetRef="Activity_producir_decidido" />
    <bpmn:sequenceFlow id="Flow_producir_decidido_registrar_produccion" sourceRef="Activity_producir_decidido" targetRef="Activity_registrar_produccion" />
    <bpmn:sequenceFlow id="Flow_registrar_produccion_fin_semana" sourceRef="Activity_registrar_produccion" targetRef="Event_fin_semana" />
    <bpmn:textAnnotation id="Annotation_a_transcripciones">
      <bpmn:text>Tarea manual: el mismo pedido se transcribe tres veces (chat, papel y lista).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_a_doble">
      <bpmn:text>Ineficiencia: doble averiguación de disponibilidad, a ojo en el depósito y preguntando a producción.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_a_datos">
      <bpmn:text>Flujo de datos: la producción se registra una vez por semana (20 % de los días) y no se cruza con las ventas; no hay stock de producto terminado registrado.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_a_criterio">
      <bpmn:text>Decide el dueño o uno de los hijos, por criterio propio y sin mirar los pedidos.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_a_extras">
      <bpmn:text>Las horas extras del mes suman unas 25; parte se usa para completar pedidos.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_a_transcripciones_papel" associationDirection="None" sourceRef="DataObjectReference_papel" targetRef="Annotation_a_transcripciones" />
    <bpmn:association id="Association_a_transcripciones_lista_datos" associationDirection="None" sourceRef="DataObjectReference_lista_datos" targetRef="Annotation_a_transcripciones" />
    <bpmn:association id="Association_a_doble_mirar" associationDirection="None" sourceRef="Activity_mirar" targetRef="Annotation_a_doble" />
    <bpmn:association id="Association_a_datos_datos_produccion" associationDirection="None" sourceRef="DataObjectReference_datos_produccion" targetRef="Annotation_a_datos" />
    <bpmn:association id="Association_a_datos_preparar" associationDirection="None" sourceRef="Activity_preparar" targetRef="Annotation_a_datos" />
    <bpmn:association id="Association_a_criterio_decidir" associationDirection="None" sourceRef="Activity_decidir" targetRef="Annotation_a_criterio" />
    <bpmn:association id="Association_a_extras_horas_extras" associationDirection="None" sourceRef="Activity_horas_extras" targetRef="Annotation_a_extras" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Atender_pedido_de_distribuidor__AS-IS_">
