<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="generar_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Atender_pedido_de_distribuidor__TO-BE_">
    <bpmn:participant id="Participant_distribuidor" name="Distribuidor" />
    <bpmn:participant id="Participant_dulxelitos" name="Dulxelitos" processRef="Process_dulxelitos" />
    <bpmn:participant id="Participant_transporte" name="Transporte tercerizado" />
    <bpmn:messageFlow id="MessageFlow_distribuidor_ini_pedido" name="Pedido por WhatsApp o teléfono" sourceRef="Participant_distribuidor" targetRef="Event_ini_pedido" />
    <bpmn:messageFlow id="MessageFlow_confirmar_distribuidor" name="Confirmación del pedido" sourceRef="Activity_confirmar" targetRef="Participant_distribuidor" />
    <bpmn:messageFlow id="MessageFlow_avisar_distribuidor" name="Aviso de faltante con fecha estimada" sourceRef="Activity_avisar" targetRef="Participant_distribuidor" />
    <bpmn:messageFlow id="MessageFlow_tercerizado_transporte" name="Pedido a entregar" sourceRef="Activity_tercerizado" targetRef="Participant_transporte" />
  </bpmn:collaboration>
  <bpmn:process id="Process_dulxelitos" isExecutable="false">
    <bpmn:laneSet id="LaneSet_dulxelitos">
      <bpmn:lane id="Lane_oficina" name="Oficina">
        <bpmn:flowNodeRef>Event_ini_pedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_cargar_nota</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_union_consulta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_consultar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_xor_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_reservar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_facturar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_avisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_espera</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_deposito" name="Depósito">
        <bpmn:flowNodeRef>Event_ini_conteo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_contar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_fin_conteo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_preparar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_xor_despacho</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_flota</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_tercerizado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_fin_pedido</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_produccion" name="Producción">
        <bpmn:flowNodeRef>Activity_producir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_cargar_produccion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_fin_produccion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_direccion" name="Dirección">
        <bpmn:flowNodeRef>Event_ini_semana</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_planificar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_ini_pedido" name="Pedido recibido">
      <bpmn:outgoing>Flow_ini_pedido_cargar_nota</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_ini_pedido" />
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_cargar_nota" name="Cargar nota de pedido en Discovery">
      <bpmn:incoming>Flow_ini_pedido_cargar_nota</bpmn:incoming>
      <bpmn:outgoing>Flow_cargar_nota_union_consulta</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_union_consulta" gatewayDirection="Converging">
      <bpmn:incoming>Flow_cargar_nota_union_consulta</bpmn:incoming>
      <bpmn:incoming>Flow_espera_union_consulta</bpmn:incoming>
      <bpmn:outgoing>Flow_union_consulta_consultar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_consultar" name="Consultar stock disponible">
      <bpmn:incoming>Flow_union_consulta_consultar</bpmn:incoming>
      <bpmn:outgoing>Flow_consultar_xor_stock</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_xor_stock" name="¿Hay stock disponible?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_consultar_xor_stock</bpmn:incoming>
      <bpmn:outgoing>Flow_xor_stock_reservar</bpmn:outgoing>
      <bpmn:outgoing>Flow_xor_stock_avisar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_reservar" name="Reservar stock">
      <bpmn:incoming>Flow_xor_stock_reservar</bpmn:incoming>
      <bpmn:outgoing>Flow_reservar_confirmar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Activity_confirmar" name="Confirmar pedido al distribuidor">
      <bpmn:incoming>Flow_reservar_confirmar</bpmn:incoming>
      <bpmn:outgoing>Flow_confirmar_preparar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Activity_facturar" name="Facturar en Discovery">
      <bpmn:incoming>Flow_preparar_facturar</bpmn:incoming>
      <bpmn:outgoing>Flow_facturar_xor_despacho</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Activity_avisar" name="Avisar faltante con fecha estimada">
      <bpmn:incoming>Flow_xor_stock_avisar</bpmn:incoming>
      <bpmn:outgoing>Flow_avisar_espera</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_espera" name="Fecha estimada cumplida">
      <bpmn:incoming>Flow_avisar_espera</bpmn:incoming>
      <bpmn:outgoing>Flow_espera_union_consulta</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_espera" />
    </bpmn:intermediateCatchEvent>
    <bpmn:startEvent id="Event_ini_conteo" name="Conteo semanal programado">
      <bpmn:outgoing>Flow_ini_conteo_contar</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_ini_conteo" />
    </bpmn:startEvent>
    <bpmn:task id="Activity_contar" name="Contar stock">
      <bpmn:incoming>Flow_ini_conteo_contar</bpmn:incoming>
      <bpmn:outgoing>Flow_contar_fin_conteo</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_fin_conteo" name="Stock contado">
      <bpmn:incoming>Flow_contar_fin_conteo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Activity_preparar" name="Preparar pedido">
      <bpmn:incoming>Flow_confirmar_preparar</bpmn:incoming>
      <bpmn:outgoing>Flow_preparar_facturar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_xor_despacho" name="¿Con qué se despacha?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_facturar_xor_despacho</bpmn:incoming>
      <bpmn:outgoing>Flow_xor_despacho_flota</bpmn:outgoing>
      <bpmn:outgoing>Flow_xor_despacho_tercerizado</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_flota" name="Despachar con flota propia">
      <bpmn:incoming>Flow_xor_despacho_flota</bpmn:incoming>
      <bpmn:outgoing>Flow_flota_fin_pedido</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_tercerizado" name="Entregar a transporte tercerizado">
      <bpmn:incoming>Flow_xor_despacho_tercerizado</bpmn:incoming>
      <bpmn:outgoing>Flow_tercerizado_fin_pedido</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_fin_pedido" name="Pedido despachado">
      <bpmn:incoming>Flow_flota_fin_pedido</bpmn:incoming>
      <bpmn:incoming>Flow_tercerizado_fin_pedido</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Activity_producir" name="Producir lo planificado">
      <bpmn:incoming>Flow_planificar_producir</bpmn:incoming>
      <bpmn:outgoing>Flow_producir_cargar_produccion</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Activity_cargar_produccion" name="Cargar producción del día">
      <bpmn:incoming>Flow_producir_cargar_produccion</bpmn:incoming>
      <bpmn:outgoing>Flow_cargar_produccion_fin_produccion</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_cargar_produccion_datos_stock">
        <bpmn:targetRef>DataObjectReference_datos_stock</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_fin_produccion" name="Producción cargada">
      <bpmn:incoming>Flow_cargar_produccion_fin_produccion</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="DataObject_datos_stock" />
    <bpmn:dataObjectReference id="DataObjectReference_datos_stock" name="Stock en Discovery" dataObjectRef="DataObject_datos_stock" />
    <bpmn:startEvent id="Event_ini_semana" name="Semana iniciada">
      <bpmn:outgoing>Flow_ini_semana_planificar</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_ini_semana" />
    </bpmn:startEvent>
    <bpmn:task id="Activity_planificar" name="Planificar producción de la semana">
      <bpmn:incoming>Flow_ini_semana_planificar</bpmn:incoming>
      <bpmn:outgoing>Flow_planificar_producir</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_planificar_tablero">
        <bpmn:targetRef>DataObjectReference_tablero</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObject id="DataObject_tablero" />
    <bpmn:dataObjectReference id="DataObjectReference_tablero" name="Tablero de 4 indicadores" dataObjectRef="DataObject_tablero" />
    <bpmn:sequenceFlow id="Flow_ini_pedido_cargar_nota" sourceRef="Event_ini_pedido" targetRef="Activity_cargar_nota" />
    <bpmn:sequenceFlow id="Flow_cargar_nota_union_consulta" sourceRef="Activity_cargar_nota" targetRef="Gateway_union_consulta" />
    <bpmn:sequenceFlow id="Flow_union_consulta_consultar" sourceRef="Gateway_union_consulta" targetRef="Activity_consultar" />
    <bpmn:sequenceFlow id="Flow_consultar_xor_stock" sourceRef="Activity_consultar" targetRef="Gateway_xor_stock" />
    <bpmn:sequenceFlow id="Flow_xor_stock_reservar" name="Sí" sourceRef="Gateway_xor_stock" targetRef="Activity_reservar" />
    <bpmn:sequenceFlow id="Flow_reservar_confirmar" sourceRef="Activity_reservar" targetRef="Activity_confirmar" />
    <bpmn:sequenceFlow id="Flow_confirmar_preparar" sourceRef="Activity_confirmar" targetRef="Activity_preparar" />
    <bpmn:sequenceFlow id="Flow_preparar_facturar" sourceRef="Activity_preparar" targetRef="Activity_facturar" />
    <bpmn:sequenceFlow id="Flow_facturar_xor_despacho" sourceRef="Activity_facturar" targetRef="Gateway_xor_despacho" />
    <bpmn:sequenceFlow id="Flow_xor_despacho_flota" name="Flota propia" sourceRef="Gateway_xor_despacho" targetRef="Activity_flota" />
    <bpmn:sequenceFlow id="Flow_xor_despacho_tercerizado" name="Transporte tercerizado" sourceRef="Gateway_xor_despacho" targetRef="Activity_tercerizado" />
    <bpmn:sequenceFlow id="Flow_flota_fin_pedido" sourceRef="Activity_flota" targetRef="Event_fin_pedido" />
    <bpmn:sequenceFlow id="Flow_tercerizado_fin_pedido" sourceRef="Activity_tercerizado" targetRef="Event_fin_pedido" />
    <bpmn:sequenceFlow id="Flow_xor_stock_avisar" name="No" sourceRef="Gateway_xor_stock" targetRef="Activity_avisar" />
    <bpmn:sequenceFlow id="Flow_avisar_espera" sourceRef="Activity_avisar" targetRef="Event_espera" />
    <bpmn:sequenceFlow id="Flow_espera_union_consulta" sourceRef="Event_espera" targetRef="Gateway_union_consulta" />
    <bpmn:sequenceFlow id="Flow_ini_semana_planificar" sourceRef="Event_ini_semana" targetRef="Activity_planificar" />
    <bpmn:sequenceFlow id="Flow_planificar_producir" sourceRef="Activity_planificar" targetRef="Activity_producir" />
    <bpmn:sequenceFlow id="Flow_producir_cargar_produccion" sourceRef="Activity_producir" targetRef="Activity_cargar_produccion" />
    <bpmn:sequenceFlow id="Flow_cargar_produccion_fin_produccion" sourceRef="Activity_cargar_produccion" targetRef="Event_fin_produccion" />
    <bpmn:sequenceFlow id="Flow_ini_conteo_contar" sourceRef="Event_ini_conteo" targetRef="Activity_contar" />
    <bpmn:sequenceFlow id="Flow_contar_fin_conteo" sourceRef="Activity_contar" targetRef="Event_fin_conteo" />
    <bpmn:textAnnotation id="Annotation_a_regla">
      <bpmn:text>Stock disponible = stock físico menos lo reservado por pedidos confirmados sin facturar. Si alcanza solo para una parte, se reserva eso y el resto queda pendiente.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_a_factura">
      <bpmn:text>La factura consume la reserva (a probar en Discovery).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_a_ajuste">
      <bpmn:text>Si hay diferencias, manda lo contado: el responsable de sistemas carga el ajuste en Discovery, con el motivo.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_a_carga">
      <bpmn:text>Se carga todos los días, al cierre del turno, y no una vez por semana. Un responsable de carga por turno, con suplente.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_a_reunion">
      <bpmn:text>Reunión diaria ventas–producción (~10 min): se mira el disponible, los pedidos pendientes y los avisos, y Producción confirma la fecha.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_a_plan">
      <bpmn:text>Decide el dueño o uno de los hijos, mirando los pedidos pendientes (los avisados con faltante) y el stock mínimo por producto.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_a_extras">
      <bpmn:text>Las horas extras son una excepción que se decide en este plan, no el arreglo habitual del faltante.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_a_regla_xor_stock" associationDirection="None" sourceRef="Gateway_xor_stock" targetRef="Annotation_a_regla" />
    <bpmn:association id="Association_a_factura_facturar" associationDirection="None" sourceRef="Activity_facturar" targetRef="Annotation_a_factura" />
    <bpmn:association id="Association_a_ajuste_contar" associationDirection="None" sourceRef="Activity_contar" targetRef="Annotation_a_ajuste" />
    <bpmn:association id="Association_a_carga_cargar_produccion" associationDirection="None" sourceRef="Activity_cargar_produccion" targetRef="Annotation_a_carga" />
    <bpmn:association id="Association_a_reunion_datos_stock" associationDirection="None" sourceRef="DataObjectReference_datos_stock" targetRef="Annotation_a_reunion" />
    <bpmn:association id="Association_a_plan_planificar" associationDirection="None" sourceRef="Activity_planificar" targetRef="Annotation_a_plan" />
    <bpmn:association id="Association_a_extras_planificar" associationDirection="None" sourceRef="Activity_planificar" targetRef="Annotation_a_extras" />
  </bpmn:process>
